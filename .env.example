# Existing server configuration (values intentionally blank)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_PASSWORD=
CRON_REFRESH_SECRET=
SITE_URL=https://example.invalid

# CARTO raster basemap tiles. Keep the real key only in .env / your host's environment settings.
CARTO_BASEMAPS_API_KEY=

# Optional AI classification and concise summaries for newly scraped news.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# Classification and summary share one request. These bounds avoid burst traffic.
NEWS_AI_MAX_ITEMS_PER_RUN=12
NEWS_AI_MIN_INTERVAL_MS=2500

# Telegram is disabled unless all four settings below are valid.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_WEBHOOK_SECRET=

# Optional delivery tuning
TELEGRAM_POLL_INTERVAL_MS=5000
TELEGRAM_API_TIMEOUT_MS=5000
TELEGRAM_OUTBOX_BATCH_SIZE=10

# Email warning delivery is disabled unless every required setting is present.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=upozornenia@example.invalid
SMTP_PASS=
EMAIL_FROM=Kde je Medveď – upozornenia <upozornenia@example.invalid>
EMAIL_REPLY_TO=kontakt@example.invalid
# Generate a random secret with at least 32 characters; never commit the real value.
NEWSLETTER_TOKEN_SECRET=
EMAIL_DIGEST_HOURS=6,12,18
EMAIL_DIGEST_TIME_ZONE=Europe/Bratislava

# Optional delivery tuning
EMAIL_POLL_INTERVAL_MS=30000
EMAIL_OUTBOX_BATCH_SIZE=10
